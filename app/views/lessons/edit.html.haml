- content_for(:title) { 'Edit' }

- content_for :sidebar do
  = button_to 'Delete', @lesson, class: 'btn btn-outline-danger float-end', method: :delete, data: { turbo_confirm: 'Are you sure you want to delete this lesson?' }

= form_with model: @lesson do |f|
  .mb-3= f.text_field :question, class: 'form-control', placeholder: 'What would you like to know?'
  = f.submit 'Save', class: 'btn btn-success'
