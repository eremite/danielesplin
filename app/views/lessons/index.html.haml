- content_for(:title) { 'Lessons' }

- content_for(:sidebar) do
  .card
    .card-header
      %h5 Questions
    .card-body
      .list-group.list-group-flush
        - Lesson.questionable.each do |lesson|
          .list-group-item
            %p= lesson.question
            .row
              .col= link_to 'Edit', [:edit, lesson], class: 'btn btn-sm btn-outline-primary w-100'
              .col= button_to 'Delete', lesson, method: :delete, class: 'btn btn-sm btn-outline-danger w-100', data: { turbo_confirm: 'Are you sure you want to delete this lesson?' }
        .list-group-item
          = form_with model: Lesson.new do |f|
            .mb-3= f.text_field :question, class: 'form-control', placeholder: 'What would you like to know?'
            .d-grid= f.submit 'Save', class: 'btn btn-outline-success w-100'


- if @lessons.empty?
  .card.shadow-sm.border-0.text-center.p-5.mt-4
    .card-body
      %h3.text-muted.mb-0.text-centered
        = random_icon style: 'font-size: 4rem'
        .mt-3= ['All caught up!', "That's it!", 'Mission Accomplished!', 'Success!', 'Finished!'].sample
        = link_to 'Show All Lessons', [:lessons, { show_all: true }], class: 'btn btn-outline-success mt-5'
- else
  .d-flex.flex-column.gap-3.mt-4{ style: 'overflow-x: hidden' }
    - @lessons.each do |lesson|
      .card.shadow-sm.border-0
        .card-header.bg-body-tertiary.d-flex.justify-content-between.align-items-center
          %h2.h5.mb-0.fw-semibold= lesson.title
          %span #{l(lesson.created_at)}
        .card-body.text-body-secondary
          = sanitize lesson.body
        .card-footer
          .float-end
            - if lesson.dismissed_at.present?
              %span.badge.bg-secondary-subtle.text-secondary-emphasis
                Dismissed #{l(lesson.dismissed_at, format: :short)}
            - else
              = button_to 'Dismiss', [lesson, :lesson_dismissals], class: 'btn btn-sm btn-outline-danger'

  .mt-3= paginate @lessons
